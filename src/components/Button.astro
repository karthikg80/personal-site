---
interface Props {
  href: string;
  variant?: 'primary' | 'secondary';
  target?: string;
  rel?: string;
}

const { href, variant = 'primary', target, rel } = Astro.props;
const computedRel = target === '_blank'
  ? Array.from(new Set(`${rel ?? ''} noopener noreferrer`.trim().split(/\s+/))).join(' ')
  : rel;
---

<a href={href} class={`button button-${variant}`} target={target} rel={computedRel}>
  <slot />
</a>

<style>
  .button {
    display: inline-block;
    padding: 0.64rem 1.1rem;
    border-radius: var(--border-radius);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 700;
    text-align: center;
    transition: all var(--transition);
    cursor: pointer;
    text-decoration: none;
  }

  .button-primary {
    background-color: var(--color-text);
    color: var(--color-bg);
    border: 1.5px solid var(--color-text);
    box-shadow: 3px 3px 0 var(--color-highlight);
    transform: rotate(-0.5deg);
  }

  .button-primary:hover {
    background-color: var(--color-primary);
    border-color: var(--color-primary);
    color: var(--color-surface);
    transform: rotate(0deg) translate(-1px, -1px);
    box-shadow: 4px 4px 0 var(--color-highlight);
  }

  .button-secondary {
    background-color: transparent;
    color: var(--color-primary);
    border: 1.5px solid var(--color-primary);
  }

  .button-secondary:hover {
    background-color: var(--color-highlight);
    color: var(--color-text);
    transform: rotate(0.5deg);
    box-shadow: none;
  }
</style>
