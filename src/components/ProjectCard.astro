---
interface Props {
  title: string;
  description: string;
  date: Date;
  tags: string[];
  link?: string;
  github?: string;
  featured?: boolean;
}

const { title, description, date, tags, link, github, featured = false } = Astro.props;

const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
});
---

<article class="project-card">
  {featured && <span class="featured-badge">Featured</span>}

  <div class="card-header">
    <h3>{title}</h3>
    <time class="date">{formattedDate}</time>
  </div>

  <p class="description">{description}</p>

  <div class="tags">
    {tags.map((tag) => (
      <span class="tag">{tag}</span>
    ))}
  </div>

  {(link || github) && (
    <div class="links">
      {link && (
        <a href={link} target="_blank" rel="noopener noreferrer" class="project-link">
          View Project →
        </a>
      )}
      {github && (
        <a href={github} target="_blank" rel="noopener noreferrer" class="project-link">
          GitHub →
        </a>
      )}
    </div>
  )}
</article>

<style>
  .project-card {
    position: relative;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius);
    padding: var(--space-lg);
    transition: all var(--transition);
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .project-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.1);
    border-color: var(--color-primary);
  }

  .featured-badge {
    position: absolute;
    top: var(--space-sm);
    right: var(--space-sm);
    background-color: var(--color-primary);
    color: white;
    font-size: var(--text-sm);
    font-weight: 600;
    padding: 0.25rem 0.75rem;
    border-radius: calc(var(--border-radius) / 2);
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-sm);
  }

  .card-header h3 {
    margin: 0;
    font-size: var(--text-xl);
    color: var(--color-text);
    flex: 1;
  }

  .date {
    color: var(--color-text-light);
    font-size: var(--text-sm);
    white-space: nowrap;
  }

  .description {
    color: var(--color-text);
    line-height: 1.6;
    margin: 0;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tag {
    background-color: var(--color-bg);
    color: var(--color-text-light);
    font-size: var(--text-sm);
    padding: 0.25rem 0.75rem;
    border-radius: calc(var(--border-radius) / 2);
    border: 1px solid var(--color-border);
  }

  .links {
    display: flex;
    gap: var(--space-sm);
    margin-top: auto;
    padding-top: var(--space-sm);
  }

  .project-link {
    color: var(--color-primary);
    font-weight: 600;
    font-size: var(--text-sm);
    transition: color var(--transition);
  }

  .project-link:hover {
    color: var(--color-primary-hover);
  }
</style>
