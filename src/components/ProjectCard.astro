---
interface Props {
  title: string;
  description: string;
  date: Date;
  tags: string[];
  href: string;
  liveUrl?: string;
  githubUrl?: string;
  featured?: boolean;
}

const {
  title,
  description,
  date,
  tags,
  href,
  liveUrl,
  githubUrl,
  featured = false,
} = Astro.props;

const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
});
---

<article class="project-card h-entry">
  {featured && <span class="featured-badge">Featured</span>}

  <div class="card-header">
    <h3 class="p-name">
      <a class="u-url" href={href}>{title}</a>
    </h3>
    <time class="date dt-published" datetime={date.toISOString()}>{formattedDate}</time>
  </div>

  <p class="description p-summary">{description}</p>

  <div class="tags">
    {tags.map((tag) => (
      <span class="tag">{tag}</span>
    ))}
  </div>

  {(liveUrl || githubUrl) && (
    <div class="links">
      {liveUrl && (
        <a href={liveUrl} target="_blank" rel="noopener noreferrer" class="project-link">
          Visit project →
        </a>
      )}
      {githubUrl && (
        <a href={githubUrl} target="_blank" rel="noopener noreferrer" class="project-link">
          GitHub →
        </a>
      )}
    </div>
  )}
</article>

<style>
  .project-card {
    position: relative;
    background: transparent;
    border: 0;
    border-top: 1px solid var(--color-border);
    border-radius: 0;
    padding: var(--space-lg) 0;
    transition: all var(--transition);
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .project-card:hover {
    transform: translateX(3px);
    box-shadow: none;
    border-color: var(--color-text);
  }

  .featured-badge {
    position: absolute;
    top: -0.72rem;
    right: 0;
    background-color: var(--color-highlight);
    color: var(--color-text);
    font-family: var(--font-sans);
    font-size: 0.68rem;
    font-weight: 700;
    padding: 0.16rem 0.55rem;
    border: 1px solid var(--color-text);
    border-radius: 50%;
    transform: rotate(3deg);
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-sm);
  }

  .card-header h3 {
    margin: 0;
    font-size: var(--text-2xl);
    color: var(--color-text);
    flex: 1;
  }

  .card-header a {
    color: inherit;
    text-decoration: none;
  }

  .card-header a:hover {
    color: var(--color-primary);
  }

  .date {
    color: var(--color-text-light);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    white-space: nowrap;
  }

  .description {
    color: var(--color-text);
    line-height: 1.6;
    margin: 0;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tag {
    background-color: transparent;
    color: var(--color-text-light);
    font-family: var(--font-sans);
    font-size: 0.72rem;
    padding: 0.1rem 0.35rem;
    border-radius: 0;
    border: 0;
    border-bottom: 1px dotted var(--color-border);
  }

  .links {
    display: flex;
    gap: var(--space-sm);
    margin-top: auto;
    padding-top: var(--space-sm);
  }

  .project-link {
    color: var(--color-primary);
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: var(--text-sm);
    transition: color var(--transition);
  }

  .project-link:hover {
    color: var(--color-primary-hover);
  }
</style>
