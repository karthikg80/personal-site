---
interface Props {
  personName: string;
}

const { personName } = Astro.props;

const navLinks = [
  { name: 'home', href: '/' },
  { name: 'about', href: '/about' },
  { name: 'now', href: '/now' },
  { name: 'notes', href: '/notes' },
  { name: 'projects', href: '/projects' },
  { name: 'wander', href: '/wander' },
  { name: 'say hello', href: '/contact' },
];

const currentPath = Astro.url.pathname;
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="site-title" aria-label={`${personName}, home`}>
      <span class="site-mark" aria-hidden="true">kg</span>
      <span>
        <strong>Karthik’s little corner</strong>
        <small>projects, notes &amp; useful things</small>
      </span>
    </a>

    <nav aria-label="Primary navigation">
      <ul class="nav-links">
        {navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={(link.href === '/' ? currentPath === '/' : currentPath.startsWith(link.href)) ? 'page' : undefined}
            >
              {link.name}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header { padding: 1.45rem 0 0; }

  .header-inner {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }

  .site-title {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    gap: 0.8rem;
    color: var(--color-text);
    text-decoration: none;
  }

  .site-title:hover { color: var(--color-primary); }

  .site-title strong {
    display: block;
    font-size: 1.12rem;
    font-weight: 500;
    line-height: 1.1;
  }

  .site-title small {
    display: block;
    margin-top: 0.2rem;
    color: var(--color-text-light);
    font-family: var(--font-sans);
    font-size: 0.69rem;
    letter-spacing: 0.02em;
  }

  .site-mark {
    display: grid;
    place-items: center;
    width: 2.7rem;
    height: 2.7rem;
    border: 1.5px solid var(--color-text);
    border-radius: 47% 53% 49% 51%;
    background: var(--color-highlight);
    font-family: var(--font-serif);
    font-size: 1.05rem;
    font-style: italic;
    transform: rotate(-4deg);
    box-shadow: 2px 2px 0 var(--color-bg), 3px 3px 0 var(--color-text);
  }

  .nav-links {
    display: flex;
    flex-wrap: wrap;
    list-style: none;
    gap: 0.45rem 1.2rem;
    margin: 0;
    padding: 0.75rem 0;
    border-block: 1px solid var(--color-border);
  }

  .nav-links a {
    position: relative;
    color: var(--color-text-light);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
  }

  .nav-links a::before {
    content: '↗';
    display: inline-block;
    margin-right: 0.28rem;
    color: var(--color-border);
    font-size: 0.78em;
    transform: rotate(45deg);
  }

  /* Handmade pen underline — replaces wavy text-decoration so it can wobble. */
  .nav-links a::after {
    content: '';
    position: absolute;
    left: 0.95em;
    right: 0.02em;
    bottom: -0.18rem;
    height: 2px;
    background: var(--color-highlight);
    opacity: 0;
    transform: rotate(-0.8deg);
    transform-origin: left center;
    pointer-events: none;
  }

  .nav-links a:hover,
  .nav-links a:focus-visible,
  .nav-links a[aria-current='page'] {
    color: var(--color-primary);
  }

  .nav-links a:focus-visible {
    outline: 3px solid var(--color-highlight);
    outline-offset: 0.2rem;
  }

  .nav-links a[aria-current='page']::after {
    opacity: 0.9;
  }

  .nav-links a:hover::after,
  .nav-links a:focus-visible::after {
    opacity: 0.9;
    animation: nav-ink-wobble 0.38s ease-out both;
  }

  @keyframes nav-ink-wobble {
    0% {
      transform: rotate(-1.6deg) translateY(1px);
    }
    55% {
      transform: rotate(0.7deg) translateY(-1px);
    }
    100% {
      transform: rotate(-0.8deg) translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-links a:hover::after,
    .nav-links a:focus-visible::after {
      animation: none;
    }
  }

  @media (min-width: 760px) {
    .site-header { padding-top: 2rem; }

    .header-inner {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }

    .nav-links {
      justify-content: flex-end;
      border-block: 0;
      padding: 0;
      max-width: 35rem;
    }
  }
</style>
