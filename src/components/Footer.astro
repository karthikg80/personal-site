---
const currentYear = new Date().getFullYear();
---

<footer>
  <div class="container footer-content">
    <p class="copyright">&copy; {currentYear} Karthik Gurumoorthy</p>
    <div class="social-links">
      <a href="/now">Now</a>
      <a href="/wander">Wander</a>
      <a href="/colophon">Colophon</a>
      <a href="https://github.com/karthikg80" rel="me noopener noreferrer" target="_blank">
        GitHub
      </a>
      <a href="https://bsky.app/profile/karthikg.in" rel="me noopener noreferrer" target="_blank">
        Bluesky
      </a>
      <a href="https://www.linkedin.com/in/karthikg80/" rel="me noopener noreferrer" target="_blank">
        LinkedIn
      </a>
      <a href="https://theafoundry.com" rel="me noopener noreferrer" target="_blank">
        Thea Foundry
      </a>
      <a href="/rss.xml">RSS</a>
    </div>
  </div>
</footer>

<style>
  footer {
    background-color: var(--color-surface);
    border-top: 1px solid var(--color-border);
    padding: var(--space-lg) 0;
    margin-top: var(--space-2xl);
  }

  .footer-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-sm);
    text-align: center;
  }

  .copyright {
    color: var(--color-text-light);
    font-size: var(--text-sm);
    margin: 0;
  }

  .social-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-md);
  }

  .social-links a {
    color: var(--color-text);
    font-weight: 500;
    transition: color var(--transition);
  }

  .social-links a:hover {
    color: var(--color-primary);
  }

  @media (min-width: 768px) {
    .footer-content {
      flex-direction: row;
      justify-content: space-between;
    }
  }
</style>
