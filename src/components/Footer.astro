---
const currentYear = new Date().getFullYear();
---

<footer>
  <div class="container footer-inner">
    <p class="signoff">
      <span aria-hidden="true">☕</span>
      Made with care, curiosity, and <a href="https://astro.build">Astro</a>.
    </p>
    <nav aria-label="Elsewhere">
      <a href="/colophon">colophon</a>
      <a href="/resume">résumé</a>
      <a href="https://github.com/karthikg80" rel="me noopener noreferrer" target="_blank">github</a>
      <a href="https://bsky.app/profile/karthikg.in" rel="me atproto noopener noreferrer" target="_blank">bluesky</a>
      <a href="/rss.xml">rss</a>
    </nav>
    <nav class="webring" aria-label="IndieWeb Webring">
      <a href="https://xn--sr8hvo.ws/previous" aria-label="Previous site in the IndieWeb Webring">← previous</a>
      <a href="https://xn--sr8hvo.ws">an indieweb webring <span aria-hidden="true">🕸💍</span></a>
      <a href="https://xn--sr8hvo.ws/next" aria-label="Next site in the IndieWeb Webring">next →</a>
    </nav>
    <p class="copyright">© {currentYear} Karthik Gurumoorthy · <a href="#main-content">back to top ↑</a></p>
  </div>
</footer>

<style>
  footer {
    padding: 0 0 var(--space-lg);
    margin-top: var(--space-lg);
  }

  .footer-inner {
    padding-top: var(--space-lg);
    border-top: 1px solid var(--color-border);
  }

  .footer-inner::before {
    content: '⁂';
    display: block;
    margin: -2.9rem auto 1.2rem;
    width: 3.5rem;
    background: var(--color-bg);
    color: var(--color-primary);
    text-align: center;
    font-size: 1.25rem;
  }

  .signoff {
    margin-bottom: 0.7rem;
    font-style: italic;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1rem;
    margin-bottom: 1rem;
  }

  .webring {
    align-items: center;
    gap: 0.35rem 0.75rem;
    margin-top: -0.25rem;
  }

  .webring a:nth-child(2) {
    color: var(--color-text-light);
  }

  nav a,
  .copyright {
    font-family: var(--font-sans);
    font-size: 0.75rem;
  }

  .copyright {
    color: var(--color-text-light);
    margin: 0;
  }
</style>
