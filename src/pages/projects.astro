---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getPerson, getProjectRecords } from '../core/storage/content.js';
import { projectLinkOfKind } from '../core/storage/map-project.js';
import { projectPath } from '../lib/projects';

const person = await getPerson();
const records = await getProjectRecords();
const projects = records.sort(
  (a, b) => b.project.createdAt.getTime() - a.project.createdAt.getTime()
);
---

<Layout
  title={`Projects - ${person.name}`}
  description="Selected work from Thea Foundry: Neighborbook, Homebase, Thea Kitchen, Pantry Mojo, and Sai Parayan Tracker."
>
  <div class="section">
    <div class="container">
      <div class="projects-header">
        <h1>Projects</h1>
        <p class="subtitle">
          A few things I have shipped since 2026. The rest of the studio catalog
          lives at <a href="https://theafoundry.com">theafoundry.com</a>.
        </p>
      </div>

      <div class="projects-grid">
        {projects.map(({ project }) => (
          <ProjectCard
            title={project.title}
            description={project.description}
            date={project.createdAt}
            tags={project.topics}
            href={projectPath(project.slug)}
            liveUrl={projectLinkOfKind(project, 'live')?.url}
            githubUrl={projectLinkOfKind(project, 'github')?.url}
            featured={project.featured}
          />
        ))}
      </div>
    </div>
  </div>
</Layout>

<style>
  .projects-header {
    max-width: var(--reading-width);
    margin-bottom: var(--space-2xl);
  }

  .projects-header h1 {
    margin-bottom: var(--space-sm);
  }

  .subtitle {
    font-size: var(--text-lg);
    color: var(--color-text-light);
    max-width: 600px;
    margin: 0;
    line-height: 1.6;
  }

  .subtitle a {
    color: var(--color-primary);
    font-weight: 500;
  }

  .projects-grid {
    display: grid;
    gap: 0 var(--space-xl);
  }

  @media (min-width: 768px) {
    .projects-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

</style>
