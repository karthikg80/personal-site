---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Contact - Karthik Gurumoorthy"
  description="Get in touch via email, LinkedIn, or GitHub. Let's connect and discuss opportunities."
>
  <div class="section">
    <div class="container content">
      <h1>Get in Touch</h1>

      <p class="intro">
        I'm always interested in hearing about new opportunities, collaborations, or just chatting about technology.
        Feel free to reach out through any of the channels below.
      </p>

      <div class="contact-methods">
        <a href="mailto:karthi@hey.com" class="contact-card">
          <div class="icon">📧</div>
          <h3>Email</h3>
          <p>karthi@hey.com</p>
        </a>

        <a href="https://www.linkedin.com/in/karthikg80/" target="_blank" rel="noopener noreferrer" class="contact-card">
          <div class="icon">💼</div>
          <h3>LinkedIn</h3>
          <p>Connect professionally</p>
        </a>

        <a href="https://github.com/karthikgurumoorthy" target="_blank" rel="noopener noreferrer" class="contact-card">
          <div class="icon">💻</div>
          <h3>GitHub</h3>
          <p>View my code</p>
        </a>
      </div>
    </div>
  </div>
</Layout>

<style>
  .content {
    max-width: 800px;
    margin: 0 auto;
    text-align: center;
  }

  h1 {
    margin-bottom: var(--space-md);
  }

  .intro {
    font-size: var(--text-lg);
    color: var(--color-text-light);
    margin-bottom: var(--space-2xl);
    line-height: 1.7;
  }

  .contact-methods {
    display: grid;
    gap: var(--space-lg);
    margin-top: var(--space-2xl);
  }

  .contact-card {
    background: var(--color-surface);
    border: 2px solid var(--color-border);
    border-radius: var(--border-radius);
    padding: var(--space-xl);
    transition: all var(--transition);
    text-decoration: none;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-sm);
  }

  .contact-card:hover {
    transform: translateY(-4px);
    border-color: var(--color-primary);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.1);
  }

  .icon {
    font-size: 3rem;
    margin-bottom: var(--space-sm);
  }

  .contact-card h3 {
    color: var(--color-text);
    margin: 0;
    font-size: var(--text-xl);
  }

  .contact-card p {
    color: var(--color-text-light);
    margin: 0;
  }

  @media (min-width: 768px) {
    .contact-methods {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
