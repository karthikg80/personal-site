---
import Layout from '../layouts/Layout.astro';
import { contactPageCards } from '../adapters/presentation/person.js';
import { getPerson } from '../core/storage/content.js';

const person = await getPerson();
const cards = contactPageCards(person);

/** Presentation-only icons — not part of the Person domain model. */
const cardIcons: Record<string, string> = {
  email: '📧',
  atproto: '☁️',
  github: '💻',
  linkedin: '💼',
  website: '⬡',
};
---

<Layout
  title={`Contact - ${person.name}`}
  description="Get in touch via email, LinkedIn, GitHub, or Bluesky."
>
  <div class="section">
    <div class="container content">
      <h1>Get in Touch</h1>

      <p class="intro">
        Product questions, collaborations, and kind hellos are welcome.
        Studio mail also lives at Thea Foundry.
      </p>

      <div class="contact-methods">
        {cards.map((card) => (
          <a
            href={card.href}
            class:list={['contact-card', card.className]}
            rel={card.rel}
            target={card.openInNewTab ? '_blank' : undefined}
          >
            <div class="icon">{cardIcons[card.kind] ?? '•'}</div>
            <h3>{card.label}</h3>
            <p>{card.detail}</p>
          </a>
        ))}
      </div>
    </div>
  </div>
</Layout>

<style>
  .content {
    max-width: 800px;
    margin: 0 auto;
  }

  h1 {
    margin-bottom: var(--space-md);
  }

  .intro {
    font-size: var(--text-lg);
    color: var(--color-text-light);
    margin-bottom: var(--space-2xl);
    line-height: 1.7;
  }

  .contact-methods {
    display: grid;
    gap: var(--space-lg);
    margin-top: var(--space-2xl);
  }

  .contact-card {
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius);
    padding: var(--space-xl);
    transition: all var(--transition);
    text-decoration: none;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-sm);
  }

  .contact-card:hover {
    transform: rotate(-0.5deg) translateY(-2px);
    border-color: var(--color-text);
    box-shadow: 4px 4px 0 var(--color-highlight);
  }

  .icon {
    font-size: 2rem;
    margin-bottom: var(--space-sm);
  }

  .contact-card h3 {
    color: var(--color-text);
    margin: 0;
    font-size: var(--text-xl);
  }

  .contact-card p {
    color: var(--color-text-light);
    margin: 0;
  }

  @media (min-width: 768px) {
    .contact-methods {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .contact-methods {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
