---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Contact - Karthik Gurumoorthy"
  description="Get in touch via email, LinkedIn, GitHub, or Bluesky."
>
  <div class="section">
    <div class="container content">
      <h1>Get in Touch</h1>

      <p class="intro">
        Product questions, collaborations, and kind hellos are welcome.
        Studio mail also lives at Thea Foundry.
      </p>

      <div class="contact-methods">
        <a href="mailto:karthi@hey.com" class="contact-card u-email" rel="me">
          <div class="icon">📧</div>
          <h3>Email</h3>
          <p>karthi@hey.com</p>
        </a>

        <a href="https://bsky.app/profile/karthikg.in" target="_blank" rel="me atproto noopener noreferrer" class="contact-card">
          <div class="icon">☁️</div>
          <h3>Bluesky</h3>
          <p>@karthikg.in</p>
        </a>

        <a href="https://github.com/karthikg80" target="_blank" rel="me noopener noreferrer" class="contact-card">
          <div class="icon">💻</div>
          <h3>GitHub</h3>
          <p>karthikg80</p>
        </a>

        <a href="https://www.linkedin.com/in/karthikg80/" target="_blank" rel="me noopener noreferrer" class="contact-card">
          <div class="icon">💼</div>
          <h3>LinkedIn</h3>
          <p>Connect professionally</p>
        </a>

        <a href="https://theafoundry.com" target="_blank" rel="me noopener noreferrer" class="contact-card">
          <div class="icon">⬡</div>
          <h3>Thea Foundry</h3>
          <p>theafoundry.com</p>
        </a>
      </div>
    </div>
  </div>
</Layout>

<style>
  .content {
    max-width: 800px;
    margin: 0 auto;
  }

  h1 {
    margin-bottom: var(--space-md);
  }

  .intro {
    font-size: var(--text-lg);
    color: var(--color-text-light);
    margin-bottom: var(--space-2xl);
    line-height: 1.7;
  }

  .contact-methods {
    display: grid;
    gap: var(--space-lg);
    margin-top: var(--space-2xl);
  }

  .contact-card {
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius);
    padding: var(--space-xl);
    transition: all var(--transition);
    text-decoration: none;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-sm);
  }

  .contact-card:hover {
    transform: rotate(-0.5deg) translateY(-2px);
    border-color: var(--color-text);
    box-shadow: 4px 4px 0 var(--color-highlight);
  }

  .icon {
    font-size: 2rem;
    margin-bottom: var(--space-sm);
  }

  .contact-card h3 {
    color: var(--color-text);
    margin: 0;
    font-size: var(--text-xl);
  }

  .contact-card p {
    color: var(--color-text-light);
    margin: 0;
  }

  @media (min-width: 768px) {
    .contact-methods {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .contact-methods {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
