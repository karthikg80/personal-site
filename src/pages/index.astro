---
import Layout from '../layouts/Layout.astro';
import HomeDoodle from '../components/HomeDoodle.astro';
import {
  mailtoHref,
  primaryEmail,
  siteDisplayHost,
} from '../adapters/presentation/person.js';
import { deriveNoteKind } from '../core/domain/note.js';
import { getPerson } from '../core/storage/content.js';
import { mapNote } from '../core/storage/map-note.js';
import { formatNoteDate, getPublishedNotes, notePath } from '../lib/notes';

const person = await getPerson();
const email = primaryEmail(person);
const [latestNote] = await getPublishedNotes();
const latestKind = latestNote ? deriveNoteKind(mapNote(latestNote.data)) : null;
---

<Layout
  title={person.name}
  description={person.tagline}
>
  <div class="home">
    <section class="intro container">
      <div class="intro-copy h-card">
        <img class="u-photo u-logo avatar" src={person.avatarPath} alt={person.name} width="72" height="72" />
        <p class="kicker">Oh, hello there.</p>
        <h1>
          I’m <span class="p-name ink-highlight">{person.displayName}</span>. I make small, useful software.
        </h1>
        <p class="lede p-note">
          Mostly for families and everyday life. Before this, I spent 18 years
          working on high-scale payment systems. Now I run
          <a class="p-org" href={person.organization.url} rel="me">{person.organization.name}</a>,
          a tiny software studio with a fondness for calm tools and clear boundaries.
        </p>
        <p class="identity-links">
          <a class="u-url u-uid" href={person.siteUrl}>{siteDisplayHost(person)}</a>
          <span aria-hidden="true">·</span>
          {email && <a class="u-email" href={mailtoHref(email.value)}>email me</a>}
          <span aria-hidden="true">·</span>
          <a href="/now">what I’m doing now</a>
        </p>
      </div>

      <HomeDoodle />
    </section>

    <section class="workbench container" aria-labelledby="workbench-title">
      <div class="section-heading">
        <p class="margin-note">on the workbench</p>
        <h2 id="workbench-title">A few things I care about</h2>
      </div>

      <ol class="note-list">
        <li>
          <span class="note-number">01</span>
          <div>
            <h3><a href="https://theafoundry.com">Thea Foundry</a></h3>
            <p>A small studio making private, thoughtful apps for households, families, and ordinary routines.</p>
          </div>
        </li>
        <li>
          <span class="note-number">02</span>
          <div>
            <h3><a href="/projects">Things I’ve made</a></h3>
            <p>From a neighborhood memory book to reading-group coordination and a calmer place for family apps.</p>
          </div>
        </li>
        <li>
          <span class="note-number">03</span>
          <div>
            <h3><a href="/wander">Wandering the web</a></h3>
            <p>A big, slightly unruly list of personal sites and feeds that I follow in my reader.</p>
          </div>
        </li>
      </ol>
    </section>

    {latestNote && (
      <section class="latest-note container" aria-labelledby="latest-note-title">
        <div>
          <p class="margin-note">from the notebook</p>
          <h2 id="latest-note-title">Latest workbench note</h2>
        </div>
        <article class:list={['h-entry', { scrap: latestKind === 'scrap' }]}>
          <time class="dt-published" datetime={latestNote.data.date.toISOString()}>
            {formatNoteDate(latestNote.data.date)}
          </time>
          {latestKind === 'reply' && <span class="rough-marker">reply</span>}
          {latestKind === 'bookmark' && <span class="rough-marker">bookmark</span>}
          {latestKind === 'scrap' && <span class="rough-marker">rough note</span>}
          <h3 class="p-name"><a class="u-url" href={notePath(latestNote)}>{latestNote.data.title}</a></h3>
          {latestNote.data.summary && <p class="p-summary">{latestNote.data.summary}</p>}
          <a class="read-note" href={notePath(latestNote)}>read the note →</a>
        </article>
      </section>
    )}

    <section class="paths container" aria-labelledby="paths-title">
      <div>
        <p class="margin-note">pick a path</p>
        <h2 id="paths-title">You might want to…</h2>
      </div>
      <ul>
        <li><a href="/about">read the longer introduction <span>→</span></a></li>
        <li><a href="/now">see what is happening lately <span>→</span></a></li>
        <li><a href="/notes">open the workbench notes <span>→</span></a></li>
        <li><a href="/projects">browse the project shelf <span>→</span></a></li>
        <li><a href="/contact">send a kind hello <span>→</span></a></li>
      </ul>
    </section>
  </div>
</Layout>

<style>
  .home { overflow: hidden; }

  .intro {
    display: grid;
    gap: var(--space-lg);
    padding-top: clamp(3.5rem, 9vw, 6.5rem);
    padding-bottom: var(--space-2xl);
  }

  .kicker,
  .margin-note {
    color: var(--color-primary);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: lowercase;
  }

  .avatar {
    display: block;
    width: 4.4rem;
    height: 4.4rem;
    margin-bottom: 1.1rem;
    border: 1.5px solid var(--color-text);
    border-radius: 47% 53% 49% 51%;
    background: var(--color-surface);
    box-shadow: 3px 3px 0 var(--color-text);
    transform: rotate(-3deg);
  }

  .kicker {
    display: inline-block;
    margin-bottom: 0.6rem;
    transform: rotate(-2deg);
  }

  h1 {
    max-width: 12ch;
    margin-bottom: 1.5rem;
    font-size: var(--text-4xl);
    font-weight: 400;
    line-height: 0.98;
  }

  h1 span {
    font-style: italic;
  }

  .lede {
    max-width: 39rem;
    font-size: clamp(1.16rem, 2.4vw, 1.38rem);
    line-height: 1.58;
  }

  .identity-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 0.65rem;
    margin-top: 1.4rem;
    font-family: var(--font-sans);
    font-size: var(--text-sm);
  }

  .identity-links span { color: var(--color-border); }

  .workbench {
    display: grid;
    gap: var(--space-lg);
    padding-block: var(--space-xl);
    border-block: 1px solid var(--color-border);
  }

  .section-heading h2,
  .paths h2 {
    max-width: 12ch;
    font-size: clamp(2rem, 5vw, 3.1rem);
  }

  .margin-note { margin-bottom: 0.4rem; }

  .note-list {
    list-style: none;
    margin: 0;
  }

  .note-list li {
    display: grid;
    grid-template-columns: 2.3rem 1fr;
    gap: 0.75rem;
    padding: 1.2rem 0;
    border-bottom: 1px dashed var(--color-border);
  }

  .note-list li:first-child { padding-top: 0; }

  .note-list li:last-child {
    padding-bottom: 0;
    border-bottom: 0;
  }

  .note-number {
    color: var(--color-primary);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    padding-top: 0.35rem;
  }

  .note-list h3 {
    margin: 0 0 0.35rem;
    font-size: 1.45rem;
  }

  .note-list p {
    color: var(--color-text-light);
    margin: 0;
  }

  .paths {
    display: grid;
    gap: var(--space-lg);
    padding-block: var(--space-2xl);
  }

  .latest-note {
    display: grid;
    gap: var(--space-lg);
    padding-block: var(--space-xl);
    border-bottom: 1px solid var(--color-border);
  }

  .latest-note h2 {
    max-width: 12ch;
    font-size: clamp(2rem, 5vw, 3.1rem);
  }

  .latest-note article {
    padding: 1.4rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    box-shadow: 4px 5px 0 rgb(41 40 32 / 7%);
    transform: rotate(0.4deg);
  }

  .latest-note time,
  .read-note {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
  }

  .latest-note time { color: var(--color-text-light); }

  .rough-marker {
    display: inline-block;
    margin-left: 0.5rem;
    padding: 0.05rem 0.3rem;
    border: 1px solid var(--color-primary);
    color: var(--color-primary);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    transform: rotate(-2deg);
  }

  .latest-note h3 {
    margin: 0.5rem 0;
    font-size: var(--text-2xl);
  }

  .latest-note p { color: var(--color-text-light); }

  .read-note { font-weight: 700; }

  .paths ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .paths li { border-bottom: 1px solid var(--color-border-soft); }

  .paths a {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.8rem 0;
    color: var(--color-text);
    text-decoration: none;
  }

  .paths a:hover { color: var(--color-primary); }
  .paths a span { transition: transform var(--transition); }
  .paths a:hover span { transform: translateX(0.25rem); }

  @media (min-width: 760px) {
    .intro {
      grid-template-columns: minmax(0, 1.7fr) minmax(14rem, 0.8fr);
      align-items: center;
    }

    .workbench,
    .latest-note,
    .paths {
      grid-template-columns: minmax(13rem, 0.75fr) minmax(0, 1.25fr);
      gap: clamp(3rem, 8vw, 7rem);
    }
  }

</style>
