---
import type { CollectionEntry } from 'astro:content';

import NoteLayout from '../../../layouts/NoteLayout.astro';
import {
  draftingSession,
  isDraftingConfigured,
  verifyDraftingSession,
} from '../../../lib/drafting-auth';
import { loadReviewNote } from '../../../lib/publishing/review-note';

export const prerender = false;

const securityHeaders = {
  'Cache-Control': 'no-store, private',
  'X-Robots-Tag': 'noindex, nofollow, noarchive',
  'Referrer-Policy': 'no-referrer',
  'X-Frame-Options': 'DENY',
  'Content-Security-Policy':
    "default-src 'self'; base-uri 'none'; connect-src 'self'; form-action 'none'; frame-ancestors 'none'; img-src 'self' https: data:; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'",
};

/** Used by frontmatter early returns. astro check ts(6133) is a false positive. */
function notFound(): Response {
  return new Response('Not found', {
    status: 404,
    headers: {
      ...securityHeaders,
      'Content-Type': 'text/plain; charset=utf-8',
    },
  });
}

if (!isDraftingConfigured()) return notFound();
if (!await verifyDraftingSession(Astro.cookies.get(draftingSession.cookieName)?.value)) {
  return notFound();
}

const slug = Astro.params.slug;
if (!slug) return notFound();

const result = await loadReviewNote(slug);
if (!result.ok) {
  if (result.status === 404) return notFound();
  return new Response(result.error, {
    status: result.status,
    headers: {
      ...securityHeaders,
      'Content-Type': 'text/plain; charset=utf-8',
    },
  });
}

const { note } = result;
const entry = {
  id: note.slug,
  collection: 'notes',
  data: note.data,
} as CollectionEntry<'notes'>;

const statusLabel = note.draft
  ? note.privacyReviewed
    ? 'Unpublished · Privacy-reviewed (this Git revision)'
    : 'Unpublished · Privacy review required'
  : note.privacyReviewed
    ? 'Public'
    : 'Unpublished';

Astro.response.headers.set('Cache-Control', securityHeaders['Cache-Control']);
Astro.response.headers.set('X-Robots-Tag', securityHeaders['X-Robots-Tag']);
Astro.response.headers.set('Referrer-Policy', securityHeaders['Referrer-Policy']);
Astro.response.headers.set('X-Frame-Options', securityHeaders['X-Frame-Options']);
Astro.response.headers.set('Content-Security-Policy', securityHeaders['Content-Security-Policy']);
---

<NoteLayout note={entry} showWebmentions={false}>
  <section slot="chrome" class="review-chrome container" data-blob-sha={note.blobSha} data-object-id={note.objectId}>
    <a class="back-link" href="/drafting">← Return to the working copy</a>
    <p class="kicker">step 3 of 4 · inspect</p>
    <h2>This is the exact Git revision.</h2>
    <p class="review-intro">Read the note below as a visitor will. Publishing is a separate action and applies only to this revision.</p>

    <ol class="review-workflow" aria-label="Publication workflow">
      <li class="complete"><span>1</span><strong>Draft</strong><small>private copy</small></li>
      <li class="complete"><span>2</span><strong>Prepare</strong><small>in Git</small></li>
      <li data-review-step="inspect" class:list={{ complete: !note.draft }} aria-current={note.draft ? 'step' : undefined}><span>3</span><strong>Inspect</strong><small>this revision</small></li>
      <li data-review-step="publish" aria-current={!note.draft ? 'step' : undefined}><span>4</span><strong>Publish</strong><small>{note.draft ? 'not public' : 'committed'}</small></li>
    </ol>

    <div class="publish-decision">
      <div>
        <p class="decision-label">Current state</p>
        <p id="review-publication-state" class="review-status">{statusLabel}</p>
        <p class="future-url">
          {note.draft ? 'Future URL' : 'Public URL'}
          <a href={note.futureUrl}>{note.futureUrl}</a>
        </p>
      </div>
      {note.canPublish ? (
        <div class="publish-action">
          <p><strong>Final decision</strong><br />Make this exact revision public after the site deploys.</p>
          <button
            type="button"
            data-publish
            data-object-id={note.objectId}
            data-slug={note.slug}
            data-expected-blob-sha={note.blobSha}
          >
            Publish this exact revision
          </button>
        </div>
      ) : (
        <p class="publish-unavailable">{note.draft ? 'This revision cannot be published until its privacy review is complete.' : 'This note is already public.'}</p>
      )}
      <p id="publish-status" class="form-status" role="status" aria-live="polite"></p>
    </div>

    <details class="revision-details">
      <summary>Revision details</summary>
      <dl>
        <div><dt>Object</dt><dd><code>{note.objectId}</code></dd></div>
        <div><dt>Slug</dt><dd><code>{note.slug}</code></dd></div>
        <div><dt>Git blob</dt><dd><code>{note.blobSha}</code></dd></div>
      </dl>
    </details>
  </section>
  <Fragment set:html={note.bodyHtml} />
</NoteLayout>

<style>
  .review-chrome {
    max-width: var(--reading-width);
    margin: 1.8rem auto 0;
    padding-bottom: 2rem;
    font-family: var(--font-sans);
    font-size: var(--text-sm);
  }

  .back-link { display: inline-block; margin-bottom: 1.5rem; }

  .kicker {
    margin-bottom: 0.45rem;
    color: var(--color-primary);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .review-chrome h2 { max-width: 15ch; margin-bottom: 0.7rem; font-family: var(--font-serif); font-size: var(--text-2xl); }
  .review-intro { max-width: 39rem; color: var(--color-text-light); }

  .review-workflow {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin: 1.5rem 0;
    list-style: none;
  }
  .review-workflow li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0 0.5rem;
    padding: 0.75rem 0.5rem 0.75rem 0;
    color: var(--color-text-light);
    border-top: 1px solid var(--color-border);
  }
  .review-workflow li::before { content: ''; grid-column: 1 / -1; position: relative; top: -0.8rem; height: 3px; background: transparent; }
  .review-workflow li.complete::before { background: var(--color-green); }
  .review-workflow li[aria-current="step"] { color: var(--color-text); }
  .review-workflow li[aria-current="step"]::before { background: var(--color-primary); }
  .review-workflow span { grid-row: 2 / 4; display: grid; width: 1.55rem; height: 1.55rem; place-items: center; border: 1px solid currentColor; border-radius: 50%; font-family: var(--font-mono); font-size: 0.62rem; }
  .review-workflow strong, .review-workflow small { grid-column: 2; line-height: 1.25; }
  .review-workflow small { font-size: 0.68rem; font-weight: 400; }

  .publish-decision {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(15rem, 0.85fr);
    gap: 1rem 1.5rem;
    padding: 1.2rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    box-shadow: 5px 6px 0 rgb(41 40 32 / 7%);
  }

  .decision-label { margin: 0 0 0.25rem; color: var(--color-primary); font-family: var(--font-mono); font-size: 0.65rem; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; }

  .review-status {
    margin: 0 0 0.8rem;
    font-weight: 700;
  }

  .future-url { margin: 0; color: var(--color-text-light); }
  .future-url a { display: block; overflow-wrap: anywhere; }

  .publish-action { padding-left: 1.2rem; border-left: 1px dashed var(--color-border); }
  .publish-action p { color: var(--color-text-light); }
  .publish-action strong { color: var(--color-text); }
  .publish-unavailable { align-self: center; color: var(--color-text-light); }

  .review-chrome button {
    padding: 0.62rem 0.82rem;
    color: #fffdf6;
    background: var(--color-primary);
    border: 1px solid var(--color-primary);
    cursor: pointer;
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 700;
  }

  .revision-details { margin-top: 1rem; color: var(--color-text-light); }
  .revision-details summary { cursor: pointer; color: var(--color-text); font-weight: 700; }
  .revision-details dl { display: grid; gap: 0.5rem; margin-top: 0.75rem; }
  .revision-details dl div { display: grid; grid-template-columns: 5rem minmax(0, 1fr); gap: 0.5rem; }
  .revision-details dt { font-weight: 700; }
  .revision-details dd { min-width: 0; overflow-wrap: anywhere; }

  .form-status {
    grid-column: 1 / -1;
    min-height: 1.2em;
    margin: 0.7rem 0 0;
    color: var(--color-primary);
    font-family: var(--font-sans);
    font-size: 0.75rem;
  }

  @media (max-width: 620px) {
    .review-workflow { grid-template-columns: repeat(2, 1fr); }
    .publish-decision { grid-template-columns: 1fr; }
    .publish-action { padding: 1rem 0 0; border-top: 1px dashed var(--color-border); border-left: 0; }
  }
</style>

<script src="../../../scripts/drafting-publish.ts"></script>
