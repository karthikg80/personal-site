---
import Layout from '../layouts/Layout.astro';
import {
  draftingSession,
  isDraftingConfigured,
  isLocalDraftingBypass,
  verifyDraftingSession,
} from '../lib/drafting-auth';

export const prerender = false;

const configured = isDraftingConfigured();
const localBypass = isLocalDraftingBypass();

if (!configured && !localBypass) {
  return new Response('Not found', {
    status: 404,
    headers: {
      'Cache-Control': 'no-store',
      'Content-Type': 'text/plain; charset=utf-8',
      'X-Robots-Tag': 'noindex, nofollow, noarchive',
    },
  });
}

const authenticated = localBypass
  || await verifyDraftingSession(Astro.cookies.get(draftingSession.cookieName)?.value);

Astro.response.headers.set('Cache-Control', 'no-store, private');
Astro.response.headers.set('Referrer-Policy', 'no-referrer');
Astro.response.headers.set('X-Frame-Options', 'DENY');
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow, noarchive');
Astro.response.headers.set('Permissions-Policy', 'camera=(), microphone=(), geolocation=()');
if (import.meta.env.PROD) {
  Astro.response.headers.set(
    'Content-Security-Policy',
    "default-src 'self'; base-uri 'none'; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; img-src 'self' data:; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'"
  );
}
---

<Layout
  title="Private drafting room"
  description="A private, device-local writing room."
  noindex
>
  <div class="drafting-shell" data-authenticated={authenticated} data-local-bypass={localBypass}>
    {!authenticated ? (
      <section class="door container" aria-labelledby="door-title">
        <p class="kicker">private writing room</p>
        <h1 id="door-title">Bring the access phrase.</h1>
        <p>
          This room is separate from the public notebook. Drafts stay encrypted
          in this browser and nothing here can publish itself.
        </p>
        <form id="access-form" class="access-form">
          <label for="access-key">Access phrase</label>
          <div>
            <input class="visually-hidden" name="username" type="text" autocomplete="username" value="Karthik" tabindex="-1" aria-hidden="true" />
            <input id="access-key" name="accessKey" type="password" autocomplete="current-password" required />
            <button type="submit">open the room</button>
          </div>
          <p id="access-status" class="form-status" role="status" aria-live="polite"></p>
        </form>
        <a href="/">← return to the public site</a>
      </section>
    ) : (
      <>
        <section id="vault-gate" class="door container" aria-labelledby="vault-title">
          <p class="kicker">encrypted on this device</p>
          <h1 id="vault-title">Unlock your notebook.</h1>
          <p>
            Your phrase derives the encryption key. It is kept only in memory
            while this tab is open, so a refresh asks for it again.
          </p>
          <form id="vault-form" class="access-form">
            <label for="vault-key">Notebook phrase</label>
            <div>
              <input id="vault-key" name="vaultKey" type="password" autocomplete="current-password" minlength="16" required />
              <button type="submit">unlock notes</button>
            </div>
            <p id="vault-status" class="form-status" role="status" aria-live="polite"></p>
          </form>
        </section>

        <section id="drafting-room" class="room" hidden>
          <header class="room-header container">
            <div>
              <p class="kicker">private drafting room</p>
              <h1>From spark to public note.</h1>
              <p class="room-intro">Write privately, prepare one exact revision, then make the publishing decision in a separate review.</p>
            </div>
            <div class="room-actions">
              <span id="save-state" role="status" aria-live="polite">saved on this device</span>
              <button id="lock-room" class="quiet-button" type="button">lock</button>
              {!localBypass && <button id="leave-room" class="quiet-button" type="button">sign out</button>}
            </div>
          </header>

          <div class="workspace container">
            <nav class="room-tools" aria-label="Drafting room tools">
              <button
                id="open-drafts"
                class="quiet-button room-tool"
                type="button"
                aria-haspopup="dialog"
                aria-controls="drafts-drawer"
              >
                Drafts <span id="draft-count" class="tool-count">1</span>
              </button>
              <button
                id="open-agent"
                class="quiet-button room-tool"
                type="button"
                aria-haspopup="dialog"
                aria-controls="agent-drawer"
              >Ask the editor</button>
            </nav>

            <dialog id="drafts-drawer" class="room-drawer drafts-drawer" aria-labelledby="drafts-title">
              <header class="drawer-header">
                <div>
                  <p class="kicker">encrypted on this device</p>
                  <h2 id="drafts-title">Drafts</h2>
                </div>
                <button class="quiet-button drawer-close" type="button" data-close-drawer aria-label="Close drafts">Close</button>
              </header>

              <div class="shelf-heading">
                <h3>Working notes</h3>
                <button id="new-draft" class="icon-button" type="button" aria-label="Create a new draft">+</button>
              </div>
              <ol id="draft-list"></ol>
              <p id="empty-draft-list" class="empty-drawer-note" hidden>No working notes yet.</p>

              <details id="published-drafts-group" class="published-drafts" hidden>
                <summary>Published copies <span id="published-draft-count" class="tool-count">0</span></summary>
                <ol id="published-draft-list"></ol>
              </details>
              <p class="device-note">These are encrypted browser copies. They are not synced. Published copies are kept only for reference and can be opened, then discarded.</p>
            </dialog>

            <article class="writing-pad">
              <label class="title-label" for="draft-title">working title</label>
              <input id="draft-title" class="title-input" type="text" maxlength="160" placeholder="Untitled note" />

              <header class="stage-progress">
                <div>
                  <p id="stage-progress-label">Step 1 of 4</p>
                  <p id="stage-progress-name">Gather</p>
                </div>
                <div
                  id="writing-stage-progress"
                  class="stage-progress-track"
                  role="progressbar"
                  aria-labelledby="stage-progress-label stage-progress-name"
                  aria-valuemin="1"
                  aria-valuemax="4"
                  aria-valuenow="1"
                >
                  <span id="stage-progress-bar"></span>
                </div>
              </header>

              <section class="stage-panel" data-panel="gather">
                <p class="stage-kicker">Gather</p>
                <h2>Start with what is true.</h2>
                <label for="draft-sparks">What actually happened?</label>
                <p class="field-help">Fragments, links, decisions, questions. Avoid sensitive source material.</p>
                <textarea id="draft-sparks" rows="16" placeholder="A few rough observations…"></textarea>
                <div class="stage-actions stage-actions-end">
                  <button class="quiet-button" type="button" data-go-stage="shape">Shape these notes →</button>
                </div>
              </section>

              <section class="stage-panel" data-panel="shape" hidden>
                <p class="stage-kicker">Shape</p>
                <h2>Find the note inside the material.</h2>
                <label for="draft-body">Current shape</label>
                <p class="field-help">Markdown is welcome. Awkwardness is allowed.</p>
                <textarea id="draft-body" rows="24" placeholder="Begin wherever the note has some energy…"></textarea>
                <div class="stage-actions">
                  <button class="quiet-button" type="button" data-go-stage="gather">← Back to sparks</button>
                  <button type="button" data-go-stage="review">Ready for a human read →</button>
                </div>
              </section>

              <section class="stage-panel review-panel" data-panel="review" hidden>
                <p class="stage-kicker">Review</p>
                <h2>Read it as its first editor.</h2>
                <p>This pass checks the writing. It does not put the note in Git or publish anything.</p>

                <section class="review-section" aria-labelledby="editorial-checks-title">
                  <h3 id="editorial-checks-title">Editorial check</h3>
                  <p>Slow down once. These are writing prompts, not permission to publish.</p>
                  <div class="checklist">
                    <label><input type="checkbox" data-check="firsthand" /> Every experience and opinion is mine.</label>
                    <label><input type="checkbox" data-check="facts" /> Names, links, claims, and timing are verified.</label>
                    <label><input type="checkbox" data-check="people" /> Other people’s privacy and consent are protected.</label>
                    <label><input type="checkbox" data-check="location" /> No live location, schedule, travel, or identifying routine leaks.</label>
                    <label><input type="checkbox" data-check="voice" /> The words still sound like something I might say.</label>
                  </div>
                  <label for="voice-note">A note to my future writing self <span class="optional">optional</span></label>
                  <textarea id="voice-note" rows="4" placeholder="What felt natural? What felt performed? What should move next time?"></textarea>
                </section>

                <div class="stage-actions">
                  <button class="quiet-button" type="button" data-go-stage="shape">← Back to the draft</button>
                  <button type="button" data-go-stage="prepare">Continue to Prepare →</button>
                </div>
              </section>

              <section class="stage-panel prepare-panel" data-panel="prepare" hidden>
                <p class="stage-kicker">Prepare</p>
                <h2>Choose what enters Git.</h2>
                <p>This is the repository boundary. The note remains unpublished until you inspect the Git revision and Publish separately.</p>

                <section class="prepare-block" aria-labelledby="prepare-title">
                  <h3 id="prepare-title">Canonical draft details</h3>
                  <p>Choose its public identity now. The slug locks after the first successful Prepare.</p>

                  <div class="metadata-grid">
                    <div class="metadata-wide">
                      <label for="prepare-slug">URL slug</label>
                      <input id="prepare-slug" type="text" maxlength="80" autocomplete="off" spellcheck="false" />
                    </div>

                    <div>
                      <label for="prepare-date">Date <span class="optional">UTC</span></label>
                      <input id="prepare-date" type="date" />
                    </div>

                    <div>
                      <label for="prepare-presentation">Format</label>
                      <select id="prepare-presentation">
                        <option value="note">note</option>
                        <option value="scrap">scrap</option>
                      </select>
                    </div>

                    <div class="metadata-wide">
                      <label for="prepare-tags">Tags <span class="optional">comma-separated · optional</span></label>
                      <input id="prepare-tags" type="text" maxlength="240" />
                    </div>

                    <div class="metadata-wide">
                      <label for="prepare-summary">Summary <span class="optional">optional</span></label>
                      <textarea id="prepare-summary" rows="2" maxlength="400" placeholder="One or two sentences, if the note needs them."></textarea>
                    </div>

                    <div class="metadata-wide">
                      <label for="prepare-reply-to">In reply to <span class="optional">optional</span></label>
                      <input id="prepare-reply-to" type="url" maxlength="500" placeholder="https://…" autocomplete="off" spellcheck="false" />
                    </div>
                  </div>

                  <div class="canonical-status" data-canonical-status>
                    <p id="prepare-future-url" class="prepare-url"></p>
                    <p id="prepare-git-status" class="prepare-status-line"></p>
                    <p id="prepare-working-status" class="prepare-status-line"></p>
                  </div>

                  <div class="repository-gate">
                    <p class="gate-label">Repository boundary</p>
                    <label class="privacy-ack">
                      <input id="privacy-acknowledgement" type="checkbox" />
                      <span><strong>I approve this exact text entering the public source repository.</strong> I reviewed it for private and sensitive information.</span>
                    </label>
                  </div>

                  <fieldset class="distribution-intent">
                    <legend>Optional distribution, only after the URL is live</legend>
                    <label><input id="distribute-webmentions" type="checkbox" /> Send Webmentions for this note</label>
                    <label><input id="distribute-bluesky" type="checkbox" /> Create a Bluesky copy</label>
                  </fieldset>

                  <div class="handoff-actions">
                    <button id="prepare-canonical" type="button">Prepare this exact draft</button>
                    <a id="review-canonical" class="review-link" hidden href="#">Inspect the Git revision →</a>
                  </div>
                  <p id="prepare-status" class="form-status" role="status" aria-live="polite"></p>
                </section>

                <details class="recovery-tools">
                  <summary>Recovery and draft tools</summary>
                  <p>Copy and download always keep publication disabled. They are escape hatches, not the ordinary publishing path.</p>
                  <div class="handoff-actions">
                    <button id="copy-handoff" class="quiet-button" type="button">Copy safe Markdown</button>
                    <button id="download-handoff" class="quiet-button" type="button">Download .md</button>
                    <button id="delete-draft" class="danger-button" type="button">Discard this draft</button>
                  </div>
                  <p id="handoff-status" class="form-status" role="status" aria-live="polite"></p>
                </details>

                <div class="stage-actions">
                  <button class="quiet-button" type="button" data-go-stage="review">← Back to editorial review</button>
                </div>
              </section>
            </article>

            <dialog id="agent-drawer" class="room-drawer agent-drawer" aria-labelledby="agent-title">
              <header class="drawer-header">
                <div>
                  <p class="kicker">optional editorial help</p>
                  <h2 id="agent-title">Ask for one useful move.</h2>
                </div>
                <button class="quiet-button drawer-close" type="button" data-close-drawer aria-label="Close editor">Close</button>
              </header>
              <p class="agent-boundary">Only this note is sent, and only when you click. Suggestions cannot approve, prepare, or publish it.</p>
              <div class="agent-moves">
                <button type="button" data-agent-mode="interview">interview me</button>
                <button type="button" data-agent-mode="shapes">offer 3 shapes</button>
                <button type="button" data-agent-mode="draft">shape a draft</button>
                <button type="button" data-agent-mode="privacy">privacy pass</button>
                <button type="button" data-agent-mode="voice">reflect on voice</button>
              </div>
              <form id="agent-form">
                <label for="agent-message">Or ask directly</label>
                <textarea id="agent-message" rows="3" maxlength="2000" placeholder="What am I avoiding here?"></textarea>
                <button type="submit">ask the editor</button>
              </form>
              <p id="agent-status" class="form-status" role="status" aria-live="polite"></p>
              <div id="agent-log" class="agent-log" role="log" aria-live="polite"></div>
            </dialog>
          </div>
        </section>
      </>
    )}
  </div>
</Layout>

<script src="../scripts/drafting-room.ts"></script>

<style>
  :global(body) { background: #eee8d8; }
  :global(.site-header), :global(footer) { display: none; }

  .drafting-shell { min-height: 100vh; }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .door {
    max-width: 42rem;
    padding-block: clamp(5rem, 15vh, 9rem);
  }

  .kicker {
    margin-bottom: 0.5rem;
    color: var(--color-primary);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .door h1, .room-header h1 {
    margin-bottom: 1rem;
    font-size: clamp(2.7rem, 8vw, 5rem);
    font-weight: 400;
  }

  .door > p:not(.kicker) {
    max-width: 35rem;
    color: var(--color-text-light);
    font-size: var(--text-lg);
  }

  .access-form {
    margin: 2rem 0 1.5rem;
    padding: 1.4rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius);
    box-shadow: 5px 6px 0 rgb(41 40 32 / 7%);
  }

  label {
    display: block;
    margin-bottom: 0.45rem;
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 700;
  }

  .access-form > div { display: flex; gap: 0.65rem; }

  input, textarea, select, button { font: inherit; }

  input, textarea, select {
    width: 100%;
    color: var(--color-text);
    background: rgb(255 253 246 / 78%);
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius);
  }

  input:focus, textarea:focus, button:focus-visible {
    outline: 3px solid rgb(230 183 45 / 48%);
    outline-offset: 2px;
  }

  .access-form input { min-width: 0; padding: 0.72rem; }

  button {
    padding: 0.62rem 0.82rem;
    color: #fffdf6;
    background: var(--color-primary);
    border: 1px solid var(--color-primary);
    border-radius: var(--border-radius);
    cursor: pointer;
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 700;
  }

  button:hover { filter: brightness(0.94); }
  button:disabled { cursor: wait; opacity: 0.58; }

  .form-status {
    min-height: 1.2em;
    margin: 0.7rem 0 0;
    color: var(--color-primary);
    font-family: var(--font-sans);
    font-size: 0.75rem;
  }

  .room { padding-bottom: 4rem; }

  .room-header {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    padding-block: 2.5rem 2rem;
    border-bottom: 1px solid var(--color-border);
  }

  .room-header,
  .workspace { max-width: 58rem; }

  .room-header h1 { margin: 0; font-size: clamp(2.4rem, 6vw, 4rem); }
  .room-intro { max-width: 38rem; margin: 0.4rem 0 0; color: var(--color-text-light); }

  .room-actions {
    display: flex;
    align-items: flex-start;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.5rem;
  }

  #save-state {
    width: 100%;
    color: var(--color-text-light);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    text-align: right;
  }

  .quiet-button {
    color: var(--color-text);
    background: transparent;
    border-color: var(--color-border);
  }

  .workspace {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.8rem;
    padding-top: 2rem;
  }

  .room-tools {
    display: flex;
    justify-content: space-between;
    gap: 0.55rem;
  }

  .room-tool {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding-inline: 0;
    border-color: transparent;
  }

  .room-tool:hover { color: var(--color-primary); filter: none; }
  .room-tool[hidden] { display: none; }

  .tool-count {
    display: inline-grid;
    min-width: 1.5rem;
    min-height: 1.5rem;
    place-items: center;
    padding-inline: 0.35rem;
    color: var(--color-text-light);
    background: rgb(255 253 246 / 72%);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.63rem;
    font-weight: 400;
  }

  .room-drawer {
    width: min(25rem, calc(100vw - 1.5rem));
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: clamp(1.2rem, 4vw, 2rem);
    color: var(--color-text);
    background: #f4efdf;
    border: 0;
    border-right: 1px solid var(--color-border);
    border-radius: 0 0.7rem 0.7rem 0;
    box-shadow: 12px 0 40px rgb(41 40 32 / 14%);
  }

  .room-drawer:not([open]),
  .published-drafts[hidden] { display: none; }

  .agent-drawer {
    margin-left: auto;
    border-right: 0;
    border-left: 1px solid var(--color-border);
    border-radius: 0.7rem 0 0 0.7rem;
    box-shadow: -12px 0 40px rgb(41 40 32 / 14%);
  }

  .room-drawer::backdrop { background: rgb(41 40 32 / 24%); }

  .drawer-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 2rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--color-border);
  }

  .drawer-header h2 { margin: 0; font-size: var(--text-2xl); }
  .drawer-close { padding: 0.35rem 0; border-color: transparent; }

  .shelf-heading { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; }
  .shelf-heading h3 { margin: 0; font-size: var(--text-lg); }

  .icon-button {
    width: 2rem;
    height: 2rem;
    padding: 0;
    border-radius: 50%;
    font-size: 1.2rem;
  }

  #draft-list,
  #published-draft-list { margin-top: 1rem; list-style: none; border-top: 1px solid var(--color-border); }
  #draft-list li,
  #published-draft-list li { border-bottom: 1px solid var(--color-border); }
  :global(.draft-list-button) {
    width: 100%;
    padding: 0.75rem 0.2rem;
    color: var(--color-text-light);
    background: transparent;
    border: 0;
    text-align: left;
  }
  :global(.draft-list-button:hover) { filter: none; color: var(--color-text); }
  :global(.draft-list-button[aria-current="true"]) { color: var(--color-primary); }
  :global(.draft-list-button strong) { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  :global(.draft-list-button time) { font-family: var(--font-mono); font-size: 0.64rem; }

  .empty-drawer-note,
  .device-note {
    color: var(--color-text-light);
    font-family: var(--font-mono);
    font-size: 0.67rem;
    line-height: 1.5;
  }

  .empty-drawer-note { margin-top: 1rem; }

  .published-drafts {
    margin-top: 2rem;
    padding-top: 1rem;
    border-top: 1px dashed var(--color-border);
  }

  .published-drafts summary {
    display: list-item;
    cursor: pointer;
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 700;
  }
  .published-drafts summary .tool-count { float: right; }

  .device-note { margin-top: 2rem; }

  .writing-pad {
    position: relative;
    min-height: 46rem;
    padding: clamp(1.3rem, 3vw, 2.2rem);
    background-color: var(--color-surface);
    background-image: repeating-linear-gradient(to bottom, transparent 0, transparent 1.85rem, rgb(185 170 141 / 20%) 1.85rem, rgb(185 170 141 / 20%) calc(1.85rem + 1px));
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius);
    box-shadow: 6px 8px 0 rgb(41 40 32 / 7%);
  }

  .writing-pad::before {
    content: '';
    position: absolute;
    top: -0.7rem;
    right: 3rem;
    width: 6rem;
    height: 1.3rem;
    background: rgb(230 183 45 / 38%);
    transform: rotate(2deg);
  }

  .title-label { color: var(--color-primary); font-family: var(--font-mono); font-size: 0.68rem; text-transform: uppercase; }
  .title-input {
    padding: 0.25rem 0 0.8rem;
    background: transparent;
    border: 0;
    border-bottom: 1px solid var(--color-border);
    font-family: var(--font-serif);
    font-size: clamp(2rem, 5vw, 3.2rem);
  }

  .stage-progress { margin: 1.2rem 0 2rem; padding-bottom: 0.9rem; border-bottom: 1px solid var(--color-border); }
  .stage-progress > div:first-child { display: flex; justify-content: space-between; gap: 1rem; align-items: baseline; }
  #stage-progress-label,
  #stage-progress-name { margin: 0; font-family: var(--font-sans); }
  #stage-progress-label { color: var(--color-text-light); font-family: var(--font-mono); font-size: 0.67rem; text-transform: uppercase; }
  #stage-progress-name { color: var(--color-primary); font-size: var(--text-sm); font-weight: 700; }
  .stage-progress-track { height: 3px; margin-top: 0.6rem; overflow: hidden; background: var(--color-border-soft); border-radius: 999px; }
  .stage-progress-track span { display: block; width: 25%; height: 100%; background: var(--color-primary); border-radius: inherit; transition: width 180ms ease; }

  .stage-kicker {
    margin: 0 0 0.25rem;
