---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
---

<Layout
  title="Resume - Karthik Gurumoorthy"
  description="Enterprise architect with 18+ years in high-scale transaction systems, modernization, and data platforms."
>
  <div class="section">
    <div class="container content">
      <div class="resume-header">
        <h1>Resume</h1>
        <Button href="/resume.pdf" variant="primary" target="_blank">Download PDF</Button>
      </div>

      <section class="resume-section">
        <h2>Professional Experience</h2>

        <div class="experience-item">
          <div class="item-header">
            <div>
              <h3>Senior Architect, Enterprise Technology</h3>
              <p class="company">Bank of America - Charlotte, NC</p>
            </div>
            <p class="date">Jun 2018 - Present</p>
          </div>
          <ul class="responsibilities">
            <li>Leading enterprise platform migration and modernization supporting 26M customers and 6M active digital users</li>
            <li>Designed end-to-end architecture across channels, transaction processing, fraud/risk decisioning, and settlement</li>
            <li>Architected zero-downtime migration for customer and transaction data across 20+ data domains</li>
            <li>Implemented governance, observability, and auditability patterns for regulatory and operational excellence</li>
          </ul>
        </div>

        <div class="experience-item">
          <div class="item-header">
            <div>
              <h3>Senior Solution Architect</h3>
              <p class="company">PenFed Credit Union - McLean, VA</p>
            </div>
            <p class="date">Jul 2017 - May 2018</p>
          </div>
          <ul class="responsibilities">
            <li>Led migration of credit decisioning from Equifax Pinnacle to FICO 9 with model validation workflows</li>
            <li>Architected rapid launch of an American Express credit card platform in three months</li>
            <li>Delivered complex customer workflows with multi-system data integrations</li>
          </ul>
        </div>

        <div class="experience-item">
          <div class="item-header">
            <div>
              <h3>Business Relationship Manager</h3>
              <p class="company">Tata Consultancy Services - Multiple Locations</p>
            </div>
            <p class="date">Apr 2013 - Jul 2017</p>
          </div>
          <ul class="responsibilities">
            <li>Managed a global delivery organization of 150+ engineers across US, Mexico, and India</li>
            <li>Scaled teams from 50 to 150 while sustaining SLA performance and strong delivery margins</li>
            <li>Drove operational excellence using metrics-driven management and automation</li>
          </ul>
        </div>

        <div class="experience-item">
          <div class="item-header">
            <div>
              <h3>Senior Technical Lead, Transaction Processing Platforms</h3>
              <p class="company">Bank of America - Charlotte, NC</p>
            </div>
            <p class="date">Nov 2004 - Mar 2013</p>
          </div>
          <ul class="responsibilities">
            <li>Led large-scale integration programs for major bank acquisitions and account migrations</li>
            <li>Built high-availability transaction authorization systems for new digital channels</li>
            <li>Established engineering practices for testing, deployment automation, and production stability</li>
          </ul>
        </div>
      </section>

      <section class="resume-section">
        <h2>Education & Continuous Learning</h2>

        <div class="education-item">
          <div class="item-header">
            <div>
              <h3>B.E., Computer Science & Engineering</h3>
              <p class="company">College of Engineering, Anna University, Chennai, India</p>
            </div>
            <p class="date">Degree</p>
          </div>
          <p>Applied Data Science Program (2021): deep learning, time series, recommendation systems, and applied ML case studies.</p>
        </div>
      </section>

      <section class="resume-section">
        <h2>Core Capabilities</h2>

        <div class="skills-grid">
          <div class="skill-category">
            <h4>System Architecture</h4>
            <p>Distributed systems, event-driven architecture, API/service design, resiliency engineering</p>
          </div>

          <div class="skill-category">
            <h4>Data & Analytics</h4>
            <p>Real-time pipelines, data governance and lineage, analytics infrastructure, ML integration</p>
          </div>

          <div class="skill-category">
            <h4>Technology Stack</h4>
            <p>Python, Java, Spring Boot, SQL/Oracle, Kafka-style streaming, REST API design</p>
          </div>

          <div class="skill-category">
            <h4>Observability & Tooling</h4>
            <p>Production monitoring, tracing, Jupyter, Tableau, Alteryx, operational runbooks</p>
          </div>

          <div class="skill-category">
            <h4>Domain Expertise</h4>
            <p>Financial services, ACH/Wire/real-time payments, fraud/risk integration, compliance</p>
          </div>

          <div class="skill-category">
            <h4>Current Focus</h4>
            <p>Enterprise use of LLMs and generative AI, including RAG patterns and document intelligence workflows</p>
          </div>
        </div>
      </section>
    </div>
  </div>
</Layout>

<style>
  .content {
    max-width: 900px;
    margin: 0 auto;
  }

  .resume-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-2xl);
    flex-wrap: wrap;
    gap: var(--space-md);
  }

  .resume-header h1 {
    margin: 0;
  }

  .resume-section {
    margin-bottom: var(--space-2xl);
    padding-bottom: var(--space-2xl);
    border-bottom: 1px solid var(--color-border);
  }

  .resume-section:last-child {
    border-bottom: none;
  }

  .resume-section h2 {
    margin-bottom: var(--space-lg);
    color: var(--color-primary);
  }

  .experience-item,
  .education-item {
    margin-bottom: var(--space-xl);
  }

  .experience-item:last-child,
  .education-item:last-child {
    margin-bottom: 0;
  }

  .item-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-md);
    margin-bottom: var(--space-sm);
  }

  .item-header h3 {
    margin: 0;
    font-size: var(--text-xl);
  }

  .company {
    color: var(--color-text-light);
    font-weight: 500;
    margin: 0.25rem 0 0 0;
  }

  .date {
    color: var(--color-text-light);
    font-size: var(--text-sm);
    white-space: nowrap;
    margin: 0;
  }

  .responsibilities {
    margin: var(--space-sm) 0 0 var(--space-md);
    color: var(--color-text);
  }

  .responsibilities li {
    margin-bottom: var(--space-xs);
    line-height: 1.6;
  }

  .skills-grid {
    display: grid;
    gap: var(--space-lg);
  }

  .skill-category {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius);
    padding: var(--space-lg);
  }

  .skill-category h4 {
    margin: 0 0 var(--space-xs) 0;
    color: var(--color-text);
    font-size: var(--text-lg);
  }

  .skill-category p {
    margin: 0;
    color: var(--color-text-light);
    line-height: 1.6;
  }

  @media (min-width: 768px) {
    .skills-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 767px) {
    .item-header {
      flex-direction: column;
    }

    .date {
      align-self: flex-start;
    }
  }
</style>
