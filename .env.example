# Production keeps /drafting unavailable until both values are configured.
DRAFTING_ACCESS_KEY=use-a-strong-private-phrase-at-least-16-characters
DRAFTING_SESSION_SECRET=use-a-random-secret-at-least-32-characters

# Optional locally. Vercel deployments use project OIDC automatically.
AI_GATEWAY_API_KEY=
DRAFTING_MODEL=openai/gpt-5.6-luna
