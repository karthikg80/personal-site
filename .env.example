# Production keeps /drafting unavailable until both values are configured.
DRAFTING_ACCESS_KEY=use-a-strong-private-phrase-at-least-16-characters
DRAFTING_SESSION_SECRET=use-a-random-secret-at-least-32-characters

# Server-only OpenAI credential for explicitly requested agent moves.
OPENAI_API_KEY=
DRAFTING_MODEL=gpt-5.6-luna

# Server-only. Fine-grained PAT, Contents R/W, this repo only. Never expose to the browser.
GITHUB_NOTES_TOKEN=
GITHUB_NOTES_OWNER=karthikg80
GITHUB_NOTES_REPO=personal-site
# Optional. Defaults to main.
# GITHUB_NOTES_BRANCH=main

# Optional. Used by `npm run posse:bluesky` and the post-promotion GitHub Action.
BLUESKY_IDENTIFIER=karthikg.in
BLUESKY_APP_PASSWORD=
